# Скопируй в .env на сервере или задай в systemd EnvironmentFile.
# Не коммить файл с реальными значениями.

# Обязательно сменить в продакшене
FLASK_SECRET_KEY=замени_на_длинную_случайную_строку
DASHBOARD_PASSWORD=надёжный_пароль

# Путь к каталогу telegram_bot (если дашборд не рядом с репозиторием)
# BOT_DIR=/opt/bot/telegram_bot

# Имя unit в systemd
# BOT_SYSTEMD_SERVICE=perfectorganic-bot

# Лимит загрузки файлов (МБ)
# MAX_UPLOAD_MB=16

# Только если админка за HTTPS (nginx)
# SESSION_COOKIE_SECURE=1

# Опционально
# DASHBOARD_UPLOADS_DIR=/var/lib/perfectorganic/uploads
# CUSTOM_PROMPTS_FILE=/var/lib/perfectorganic/custom_prompts.json
