[Unit]
Description=Perfect Organic Telegram Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bot/telegram_bot
ExecStart=/usr/bin/python3 /opt/bot/telegram_bot/bot.py
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/bot/telegram_bot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
